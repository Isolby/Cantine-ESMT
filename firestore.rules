rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Permettre la lecture et l'écriture pour les commandes
    match /commandes/{document=**} {
      allow read, write: if request.auth != null || true;
    }

    // Permettre la lecture et l'écriture pour les plats
    match /plats/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Permettre la lecture et l'écriture pour les etudiants
    match /etudiants/{document=**} {
      allow read, write: if true;
    }

    // Permettre la lecture et l'écriture pour les gerants
    match /gerants/{document=**} {
      allow read, write: if request.auth != null;
    }

    // Admin collection - seulement pour les admins
    match /admins/{document=**} {
      allow read, write: if request.auth != null;
    }

  }
}
